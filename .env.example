# Every environment variable this blueprint uses, in one place.
#
# There is no root .env: each app reads its own. Copy the block you need into
# apps/mastra/.env and apps/web/.env (both gitignored) — see the repo README.
# In production the platform supplies these; the built servers do not read .env.

# ── apps/mastra/.env ──────────────────────────────────────────────────────
# PostgreSQL for the app tables AND Mastra's own storage (runs, traces, memory).
# Local: docker compose up -d (host port 5437).
# On Rock8Cloud: link the provisioned PostgreSQL DATABASE_URL to the mastra service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/mastra_blueprint

# OpenAI-compatible AI gateway. The base URL is the API root that has
# /chat/completions under it — usually the one ending in /v1. Any compatible
# endpoint works (a gateway, a self-hosted vLLM, OpenAI itself); no provider is
# hardcoded anywhere in src/.
AI_GATEWAY_BASE_URL=https://your-gateway.example.com/v1
AI_GATEWAY_API_KEY=sk-...
# Model id as your gateway knows it.
AI_MODEL=gpt-5

# Set to "true" when the database presents a self-signed certificate (managed
# Postgres like Rock8Cloud's): Mastra's storage then encrypts without
# verifying, matching the postgres.js driver's sslmode=require semantics.
# DATABASE_SSL_NO_VERIFY=true

# Port the Mastra server binds. Defaults to 4111 when unset — set it only if
# 4111 is taken locally, and change MASTRA_API_URL below to match. In production
# Rock8Cloud injects PORT; do not set it manually there.
# PORT=4111

# ── apps/web/.env ─────────────────────────────────────────────────────────
# URL of the Mastra server. Read server-side per request; the browser never
# calls Mastra, the database or the AI gateway directly.
MASTRA_API_URL=http://localhost:4111

# Port the web server binds in production (bun run start). Dev uses 3000 via
# the vite script. Injected by Rock8Cloud in production.
# PORT=3000
